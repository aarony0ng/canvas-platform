# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://canvas:canvas@localhost:5432/canvas_platform

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=your_fernet_key_here

# 32-byte hex secret for session signing
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=your_session_secret_here

# ── Email ─────────────────────────────────────────────────────────────────────
SENDGRID_API_KEY=your_sendgrid_key_here
EMAIL_FROM=notifications@yourdomain.com
EMAIL_FROM_NAME=Canvas Checker

# ── App ───────────────────────────────────────────────────────────────────────
APP_URL=http://localhost:5173
ENVIRONMENT=development
